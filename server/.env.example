# Copia este archivo a .env y ajusta los valores. Nunca commitear .env real.

# Postgres (coincide con docker-compose.yml)
POSTGRES_USER=cronograma_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=cronograma_produccion
# 5433 en vez de 5432: evita chocar con un Postgres nativo/otro proyecto que
# ya esté usando el puerto por defecto en tu máquina.
POSTGRES_PORT=5433

DATABASE_URL="postgresql://cronograma_app:change_me_strong_password@localhost:5433/cronograma_produccion?schema=public"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth (generar valores aleatorios largos reales, no usar estos en producción)
JWT_ACCESS_SECRET=replace_with_64+_char_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_64+_char_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seguridad de cuenta
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Usuario superadmin inicial (solo se usa en el seed, la contraseña se hashea con bcrypt)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=change_me_on_first_login

# --- TLS / HTTPS ---------------------------------------------------------
# En producción el arranque falla si no hay una de las dos opciones activa.
#
# Opción A: este proceso termina TLS con sus propios certificados.
#   node scripts/generar-certificado-dev.mjs   (solo para desarrollo)
TLS_ENABLED=false
# TLS_KEY_PATH=certs/dev-key.pem
# TLS_CERT_PATH=certs/dev-cert.pem
# TLS_CA_PATH=certs/ca-chain.pem
#
# Opción B: un proxy/balanceador ya terminó el TLS y reenvía por HTTP interno.
# Con esto activo se rechaza toda petición que no llegue como HTTPS.
TLS_TERMINATED_BY_PROXY=false
# Saltos de proxy de confianza para leer X-Forwarded-Proto / X-Forwarded-For.
TRUST_PROXY_HOPS=1
# HSTS: 2 años, el mínimo que pide la preload list.
HSTS_MAX_AGE_SECONDS=63072000

# --- Respaldos -----------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
